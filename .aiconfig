# .aiconfig
# Declarative manifest for aictl resources

# Tools installed on this system
tools:
  - windsurf
  - cursor

# Resources to install
install:
  # Install to all tools
  - name: bundled/typescript-rules

  # Install to specific tool only
  - name: bundled/jira-context
    tools: [windsurf]

# Default scope (local for project-specific, global for system-wide)
scope: local
